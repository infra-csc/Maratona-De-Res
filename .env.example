# ─────────────────────────────────────────────────────────────────────────────
# .env.example — variáveis de ambiente do Maratona (API + build do web)
# Copie para `.env` na raiz do projeto e preencha. NUNCA comite o `.env`.
# A API carrega `.env` da raiz sozinha (node --env-file-if-exists); em produção
# você também pode usar o EnvironmentFile do systemd ou o env do PM2.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# ── Banco (Neon) ─────────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST/neondb?sslmode=verify-full
# (verify-full evita o aviso do driver pg; equivale ao require atual)
DATABASE_URL=
# Conexões por processo (o Neon free/launch aceita poucas; 10 é seguro).
PG_POOL_MAX=10

# ── Autenticação ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO. Gere com: openssl rand -base64 48
# Use o MESMO valor do Replit para não derrubar as sessões abertas na troca.
JWT_SECRET=
# SSO do portal NORTE (POST /auth/portal-sso). Mesmo valor que o portal usa.
SESSION_SECRET=

# ── Arquivos (áudios das avaliações) ─────────────────────────────────────────
# Pasta em disco onde ficam os uploads (substitui o Object Storage do Replit).
# Use caminho absoluto fora do diretório do código e inclua no backup.
STORAGE_DIR=/var/lib/maratona/storage
# Segredo das URLs de upload; se vazio usa JWT_SECRET.
STORAGE_SIGNING_SECRET=
# Tamanho máximo de um upload, em MB.
STORAGE_MAX_UPLOAD_MB=25
# Prefixo público da API usado nas URLs de upload (padrão /api).
API_PUBLIC_BASE=/api

# ── Front-end ────────────────────────────────────────────────────────────────
# Caminho ABSOLUTO. Se preenchido, a própria API serve o build do web (SPA) neste diretório.
# Deixe vazio se o Nginx for servir os arquivos estáticos.
STATIC_DIR=/opt/maratona/artifacts/maratona/dist/public
# Base do build do web (vite). Mude só se o app ficar num subcaminho.
BASE_PATH=/

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula. Vazio = qualquer origem.
ALLOWED_ORIGINS=https://maratona.seudominio.com.br

# ── Integração externa (importação de funcionários/eventos) ──────────────────
# Hoje aponta para outro app no Replit (logistica-interna.replit.app).
EXTERNAL_API_URL=
EXTERNAL_API_TOKEN=

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
