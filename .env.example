# ─────────────────────────────────────────────────────────────────────────────
# .env.example — variáveis de ambiente do Maratona (API + build do web)
# Copie para `.env` na raiz do projeto e preencha. NUNCA comite o `.env`.
# A API carrega `.env` da raiz sozinha (node --env-file-if-exists); em produção
# você também pode usar o EnvironmentFile do systemd ou o env do PM2.
# Descrição completa de cada variável: docs/VARIAVEIS-DE-AMBIENTE.md
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# ── Banco (PostgreSQL) ───────────────────────────────────────────────────────
# Produção (Postgres na mesma VPS): postgresql://maratona:SENHA@127.0.0.1:5432/maratona
# Banco gerenciado (Neon etc.): acrescente ?sslmode=verify-full
DATABASE_URL=
# Conexões por processo (10 é seguro).
PG_POOL_MAX=10

# ── Autenticação ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO. Gere com: openssl rand -base64 48
# Trocar o valor desloga todo mundo (os tokens antigos deixam de valer).
JWT_SECRET=
# Opcional. SSO do portal NORTE (POST /auth/portal-sso). Mesmo valor que o portal usa.
# Vazio: SSO desligado; o login normal continua funcionando.
SESSION_SECRET=

# ── Arquivos (áudios das avaliações) ─────────────────────────────────────────
# Pasta em disco onde ficam os uploads. Vazio: ./data/storage (relativo à pasta de execução).
# Use caminho absoluto fora do diretório do código e inclua no backup.
STORAGE_DIR=/var/lib/maratona/storage
# Segredo das URLs de upload; se vazio usa JWT_SECRET.
STORAGE_SIGNING_SECRET=
# Tamanho máximo de um upload, em MB.
STORAGE_MAX_UPLOAD_MB=25
# Prefixo público da API usado nas URLs de upload (padrão /api).
API_PUBLIC_BASE=/api

# ── Front-end ────────────────────────────────────────────────────────────────
# Caminho ABSOLUTO. Se preenchido, a própria API serve o build do web (SPA) neste diretório.
# Deixe vazio se o Nginx for servir os arquivos estáticos.
STATIC_DIR=/opt/maratona/artifacts/maratona/dist/public
# Base do build do web (vite). Mude só se o app ficar num subcaminho.
BASE_PATH=/

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula. Vazio = qualquer origem.
# Front e API no mesmo domínio: pode ficar vazio.
ALLOWED_ORIGINS=https://maratonaresultados.appsnorte.com

# ── Integração externa (importação de funcionários/eventos) ──────────────────
# Opcional. Sistema de onde a tela "Integração" importa colaboradores, eventos e
# participações (contrato em docs/decisoes/integration-external-sync.md).
# Vazio: sincronização "não configurada".
EXTERNAL_API_URL=
EXTERNAL_API_TOKEN=

# ── Proxy reverso ────────────────────────────────────────────────────────────
# Quem pode informar o IP real do cliente (X-Forwarded-For). Padrão: loopback
# (Nginx na mesma máquina). Use false se a API ficar exposta direto.
TRUST_PROXY=loopback

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
