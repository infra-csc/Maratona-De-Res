# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variáveis de ambiente da API Server
# Copie este arquivo para .env e preencha os valores antes de rodar localmente.
# NUNCA comite o .env com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Porta em que o servidor HTTP escuta.
# No Replit, o valor é injetado automaticamente pelo ambiente.
PORT=8080

# Ambiente de execução: development | production | test
NODE_ENV=development

# ── Autenticação ──────────────────────────────────────────────────────────────

# Secret usado para assinar e verificar JWTs.
# Gere com: openssl rand -base64 48
# OBRIGATÓRIO — o servidor não sobe sem este valor.
JWT_SECRET=troque-por-um-valor-seguro

# Secret para sessões HTTP (Replit SSO / portal auth).
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-valor-seguro

# ── Banco de dados ────────────────────────────────────────────────────────────

# URL de conexão com o PostgreSQL.
# Exemplo local: postgres://postgres:postgres@localhost:5432/maratona
# No Replit, é injetada automaticamente quando o banco é vinculado ao projeto.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Armazenamento de objetos (áudios de avaliação) ────────────────────────────

# ID do bucket de object storage configurado no Replit.
# No Replit, é injetado automaticamente pelo Replit Object Storage.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# Pasta raiz dos objetos privados (áudios autenticados).
# Ex: uploads
PRIVATE_OBJECT_DIR=uploads

# Prefixos de caminho públicos (separados por vírgula).
# Objetos nestes caminhos são servidos sem autenticação.
# Ex: public,assets
PUBLIC_OBJECT_SEARCH_PATHS=public

# ── Integração externa ────────────────────────────────────────────────────────

# URL base da API externa de onde os dados de funcionários/eventos são importados.
# Ex: https://sistema-externo.example.com/api
EXTERNAL_API_URL=

# Token de autenticação Bearer para a API externa.
EXTERNAL_API_TOKEN=

# ── CORS ──────────────────────────────────────────────────────────────────────

# Lista de origens permitidas, separadas por vírgula.
# Em desenvolvimento com Replit, REPLIT_DEV_DOMAIN é detectado automaticamente.
# Em produção, adicione o domínio do frontend aqui.
# Ex: https://meuapp.exemplo.com,https://staging.exemplo.com
ALLOWED_ORIGINS=

# ── Logs ──────────────────────────────────────────────────────────────────────

# Nível de log do Pino: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
